---
import { ONLINE, UBICACIONES } from "../data/site";

const consultas = [
  ...UBICACIONES.map((u) => ({ href: `/${u.slug}/`, texto: `Psicóloga en ${u.nombre}` })),
  { href: `/${ONLINE.slug}/`, texto: "Psicóloga online" },
];
---

<footer class="border-t border-border bg-background py-8">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-5 px-6 sm:flex-row sm:items-center">
    <a href="/" class="font-display text-xl text-primary">ConCiencia Psicología</a>
    <div class="flex flex-col gap-2 sm:items-end">
      <p class="text-base font-medium text-muted-foreground sm:text-lg">Online · Benisanó · Sagunto · Valencia</p>
      <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted-foreground">
        <a href="/aviso-legal/" class="underline underline-offset-4">Aviso legal</a>
        <a href="/privacidad/" class="underline underline-offset-4">Privacidad</a>
        <a href="/cookies/" class="underline underline-offset-4">Política de cookies</a>
        <button type="button" class="underline underline-offset-4" data-cookie-open>Preferencias de cookies</button>
      </div>
    </div>
  </div>
  <nav aria-label="Consultas" class="mx-auto mt-6 max-w-6xl px-6">
    <ul class="flex flex-wrap gap-x-4 gap-y-1 border-t border-border pt-5 text-sm text-muted-foreground">
      {consultas.map(({ href, texto }) => <li><a href={href} class="hover:text-primary hover:underline underline-offset-4">{texto}</a></li>)}
      <li><a href="/preguntas-frecuentes/" class="hover:text-primary hover:underline underline-offset-4">Preguntas frecuentes</a></li>
    </ul>
  </nav>
</footer>

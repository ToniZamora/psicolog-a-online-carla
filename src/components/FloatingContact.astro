---
import { Icon } from "astro-icon/components";
import { emailUrl, whatsappUrl } from "../data/site";
import { btn } from "../lib/ui";
---

<div class="fixed bottom-5 right-5 z-40 flex flex-col gap-3">
  <a
    href={emailUrl}
    aria-label="Escríbeme por correo"
    title="Escríbeme por correo"
    class={btn({ variant: "outline", size: "icon", class: "size-12 rounded-full bg-background" })}
  >
    <Icon name="lucide:mail" aria-hidden="true" />
  </a>
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Abrir chat de WhatsApp"
    title="Escríbeme por WhatsApp"
    class={btn({ size: "icon", class: "size-12 rounded-full bg-whatsapp text-whatsapp-foreground hover:bg-whatsapp/90" })}
  >
    <Icon name="lucide:message-circle" aria-hidden="true" />
  </a>
</div>

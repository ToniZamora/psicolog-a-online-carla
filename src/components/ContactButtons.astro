---
import { Icon } from "astro-icon/components";
import { emailUrl, whatsappUrl } from "../data/site";

interface Props {
  center?: boolean;
}
const { center = false } = Astro.props;
---

<div class:list={["btn-row", { center }]}>
  <a class="btn btn-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
    <Icon name="lucide:message-circle" aria-hidden="true" />
    Escríbeme por WhatsApp
  </a>
  <a class="btn btn-outline" href={emailUrl}>
    <Icon name="lucide:mail" aria-hidden="true" />
    Escríbeme por correo
  </a>
</div>

<style>
  .center {
    justify-content: center;
  }
</style>

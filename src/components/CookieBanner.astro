---
import { btn } from "../lib/ui";
---

<aside
  aria-label="Aviso de cookies"
  class="fixed inset-x-4 bottom-4 z-[60] mx-auto max-w-3xl rounded-2xl border border-border bg-card p-5 text-card-foreground shadow-2xl md:p-6"
  data-cookie-banner
  hidden
>
  <h2 class="font-display text-xl font-semibold">Tu privacidad importa</h2>
  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
    Usamos almacenamiento técnico necesario para el funcionamiento de la web. El mapa de Google solo se
    carga si aceptas los servicios externos opcionales. Puedes rechazarlos y seguir usando el sitio.
  </p>
  <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <a href="/cookies/" class="text-sm font-medium text-primary underline underline-offset-4">Más información</a>
    <div class="flex flex-col gap-2 sm:flex-row">
      <button type="button" class={btn({ variant: "outline" })} data-cookie-choice="rejected">Solo necesarias</button>
      <button type="button" class={btn()} data-cookie-choice="accepted">Aceptar servicios externos</button>
    </div>
  </div>
</aside>

<script>
  import { getConsent, setConsent, type Consent } from "../lib/consent";

  const banner = document.querySelector<HTMLElement>("[data-cookie-banner]");
  if (banner && getConsent() === null) banner.hidden = false;

  banner?.querySelectorAll<HTMLButtonElement>("[data-cookie-choice]").forEach((b) => {
    b.addEventListener("click", () => {
      setConsent(b.dataset["cookieChoice"] as Consent);
      banner.hidden = true;
    });
  });

  document.querySelectorAll<HTMLElement>("[data-cookie-open]").forEach((el) => {
    el.addEventListener("click", () => {
      if (!banner) return;
      banner.hidden = false;
      banner.querySelector<HTMLButtonElement>("[data-cookie-choice]")?.focus();
    });
  });
</script>

---
import { Icon } from "astro-icon/components";
import { NAV } from "../data/site";
import { btn } from "../lib/ui";

const actual = Astro.url.pathname;
const NAV_ORIGINAL = NAV.map((n) =>
  n.href === "/ambitos/" ? { ...n, texto: "Ámbitos de intervención" } : n.href === "/formacion/" ? { ...n, texto: "Mi formación" } : n,
);
const link = btn({ variant: "ghost", class: "justify-start px-3" });
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-background/95 backdrop-blur-md" data-header>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" aria-label="ConCiencia Psicología, inicio" class="shrink-0 font-display text-2xl leading-tight text-primary">
      ConCiencia
      <span class="mt-1 block font-body text-[10px] font-medium uppercase">Psicología</span>
    </a>
    <nav aria-label="Navegación principal" class="hidden items-center gap-0 md:flex">
      {
        NAV_ORIGINAL.map(({ href, texto }) => (
          <a class={link} href={href} aria-current={actual === href ? "page" : undefined}>
            {texto}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      class={btn({ variant: "ghost", size: "icon", class: "md:hidden" })}
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
    >
      <Icon name="lucide:menu" class="icon-open" aria-hidden="true" />
      <Icon name="lucide:x" class="icon-close hidden" aria-hidden="true" />
    </button>
  </div>
  <nav
    id="mobile-navigation"
    aria-label="Navegación móvil"
    class="flex flex-col gap-1 border-t border-border px-6 pb-5 pt-3 md:hidden"
    hidden
  >
    {
      NAV_ORIGINAL.map(({ href, texto }) => (
        <a class={link} href={href} aria-current={actual === href ? "page" : undefined}>
          {texto}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobile-navigation");

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    toggle.querySelector(".icon-open")?.classList.toggle("hidden", open);
    toggle.querySelector(".icon-close")?.classList.toggle("hidden", !open);
  }

  toggle?.addEventListener("click", () => setOpen(menu?.hidden ?? false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>

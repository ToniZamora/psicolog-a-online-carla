---
import { Icon } from "astro-icon/components";
import { btn } from "../lib/ui";

interface Props {
  label: string;
  title: string;
}
const { label, title } = Astro.props;
---

<section class="editorial-intro pb-14 pt-8 md:pb-20 md:pt-10">
  <div class="mx-auto max-w-6xl px-6">
    <a href="/" class={btn({ variant: "link", class: "h-auto px-0 py-2" })}>
      <Icon name="lucide:arrow-left" aria-hidden="true" />
      Volver al inicio
    </a>
    <div class="mx-auto mt-10 max-w-3xl text-center md:mt-12">
      <p class="text-sm font-semibold uppercase text-primary">{label}</p>
      <h1 class="mt-5 font-display text-4xl font-normal leading-tight md:text-5xl">{title}</h1>
      {
        Astro.slots.has("default") && (
          <div class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
            <slot />
          </div>
        )
      }
    </div>
  </div>
</section>

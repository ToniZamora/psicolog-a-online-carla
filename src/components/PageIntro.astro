---
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
}
const { eyebrow, title, accent } = Astro.props;
---

<section class="intro">
  <svg class="intro-shape" viewBox="0 0 600 400" aria-hidden="true">
    <path
      d="M420 20c90 10 170 80 170 170s-60 190-170 200S230 330 200 250 140 90 220 40s110-30 200-20Z"
      fill="currentColor"></path>
  </svg>
  <div class="wrap-narrow intro-inner">
    <p class="eyebrow reveal">{eyebrow}</p>
    <h1 class="reveal reveal-1">
      {title}
      {accent && <span class="intro-accent">{accent}</span>}
    </h1>
    <div class="lead reveal reveal-2">
      <slot />
    </div>
  </div>
</section>

<style>
  .intro {
    position: relative;
    overflow: hidden;
    padding-block: clamp(56px, 9vw, 112px) clamp(48px, 7vw, 88px);
    background: linear-gradient(180deg, var(--paper-2), var(--paper));
    text-align: center;
  }

  .intro-shape {
    position: absolute;
    right: -120px;
    top: -60px;
    width: 520px;
    color: var(--sage);
    opacity: 0.7;
  }

  .intro-inner {
    position: relative;
  }

  .intro h1 {
    margin-top: 18px;
  }

  .intro-accent {
    display: block;
    margin-top: 10px;
    font-size: 0.5em;
    font-style: italic;
    color: var(--green);
  }

  .intro .lead {
    max-width: 58ch;
    margin: 22px auto 0;
  }

  @media (max-width: 640px) {
    .intro-shape {
      width: 340px;
      right: -160px;
    }
  }
</style>

---
import { Icon } from "astro-icon/components";
import { UBICACIONES, mapsEmbedUrl, mapsSearchUrl } from "../data/site";
import { btn } from "../lib/ui";
---

<section class="border-t border-border bg-secondary/50 py-16 md:py-20" aria-labelledby="consultas-title">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-8 md:grid-cols-[1fr_1.4fr] md:gap-14">
      <div>
        <p class="text-xs font-semibold uppercase text-primary">Ubicaciones</p>
        <h2 id="consultas-title" class="mt-4 font-display text-3xl leading-tight md:text-4xl">Más cerca de ti.</h2>
        <p class="mt-5 text-left leading-relaxed text-muted-foreground xl:text-justify">
          Atención presencial en Benisanó, Sagunto y Valencia, y sesiones online desde donde estés.
        </p>
        <div class="mt-8 divide-y divide-border border-y border-border">
          <a href="/psicologia-online/" class="flex items-center gap-3 py-5 hover:text-primary">
            <Icon name="lucide:video" class="size-6 text-primary" aria-hidden="true" />
            <span>Online</span>
          </a>
          {
            UBICACIONES.map((u) => (
              <div class="flex items-center justify-between">
                <a href={`/${u.slug}/`} class="flex flex-1 items-center gap-3 py-5 hover:text-primary">
                  <Icon name="lucide:map-pin" class="size-6 text-primary" aria-hidden="true" />
                  {u.nombre}
                </a>
                <a
                  href={mapsSearchUrl(u)}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Abrir ${u.centro} en ${u.nombre} en Google Maps`}
                  title="Abrir en Google Maps"
                  class="p-2 text-primary"
                >
                  <Icon name="lucide:arrow-up-right" class="size-6" aria-hidden="true" />
                </a>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <div class="mb-3 flex gap-2" role="group" aria-label="Localidad del mapa">
          {
            UBICACIONES.map((u, i) => (
              <button
                type="button"
                class={btn({ variant: i === 0 ? "default" : "outline", size: "sm" })}
                aria-pressed={i === 0 ? "true" : "false"}
                data-map-tab
                data-embed={mapsEmbedUrl(u)}
                data-title={`Mapa de ${u.centro} en ${u.nombre}`}
              >
                {u.nombre}
              </button>
            ))
          }
        </div>
        <div class="relative h-80 overflow-hidden rounded-md border border-border bg-muted md:h-96" data-map-frame>
          <div class="flex h-full flex-col items-center justify-center gap-3 px-6 text-center" data-map-blocked>
            <p class="max-w-sm text-sm text-muted-foreground">
              El mapa de Google solo se carga si aceptas los servicios externos opcionales.
            </p>
            <button type="button" class="text-sm underline underline-offset-4" data-cookie-open>Preferencias de cookies</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { getConsent, onConsentChange } from "../lib/consent";
  import { btn } from "../lib/ui";

  const frame = document.querySelector<HTMLElement>("[data-map-frame]");
  const blocked = document.querySelector<HTMLElement>("[data-map-blocked]");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-map-tab]")];
  let current = tabs[0];

  function render() {
    if (!frame || !blocked || !current) return;
    frame.querySelector("iframe")?.remove();
    if (getConsent() !== "accepted") {
      blocked.hidden = false;
      return;
    }
    blocked.hidden = true;
    const iframe = document.createElement("iframe");
    iframe.src = current.dataset["embed"] ?? "";
    iframe.title = current.dataset["title"] ?? "Mapa";
    iframe.className = "h-full w-full border-0";
    iframe.loading = "lazy";
    iframe.referrerPolicy = "no-referrer";
    frame.append(iframe);
  }

  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      current = tab;
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-pressed", String(on));
        t.className = btn({ variant: on ? "default" : "outline", size: "sm" });
      });
      render();
    }),
  );

  onConsentChange(render);
  render();
</script>

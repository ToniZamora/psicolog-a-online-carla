---
import { Icon } from "astro-icon/components";

interface Props {
  preguntas: { p: string; r: string }[];
  nivel?: "h2" | "h3";
}
const { preguntas, nivel = "h3" } = Astro.props;
const H = nivel;
---

<div class="border-t border-border">
  {
    preguntas.map(({ p, r }) => (
      <details class="faq-item border-b border-border">
        <summary class="flex cursor-pointer items-center justify-between gap-5 py-6">
          <H class="font-display text-xl leading-snug md:text-2xl">{p}</H>
          <Icon name="lucide:plus" class="faq-icon size-5 shrink-0 text-primary transition-transform" aria-hidden="true" />
        </summary>
        <p class="pb-6 leading-relaxed text-muted-foreground">{r}</p>
      </details>
    ))
  }
</div>

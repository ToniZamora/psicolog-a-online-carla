---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import FrameGuard from "../components/FrameGuard.astro";
import BareHeader from "../components/BareHeader.astro";
import { TITULAR } from "../data/site";

const input = "mt-1 w-full rounded-xl border border-input bg-background px-4 py-2.5";
---

<Base
  title="Reservar cita · Carla Castellano, psicóloga"
  description="Consulta los horarios disponibles y reserva tu sesión con Carla Castellano."
  noindex
  bare
>
  <FrameGuard />
  <div class="min-h-screen bg-background" data-step="choose">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <BareHeader />
      <h1 class="mt-6 font-display text-5xl font-medium">Reserva tu cita</h1>
      <p class="mt-3 text-lg text-muted-foreground">Sesiones de 50 minutos. Elige un hueco libre.</p>
      <div class="mt-4 flex gap-5 text-sm" aria-hidden="true">
        <span class="flex items-center gap-2"><span class="size-3 rounded-full bg-primary"></span> Libre</span>
        <span class="flex items-center gap-2"><span class="size-3 rounded-full bg-muted"></span> Ocupado</span>
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-[1.5fr_1fr]">
        <div class="space-y-8" data-days aria-live="polite">
          <p class="text-muted-foreground">Cargando horarios…</p>
        </div>

        <form class="h-fit rounded-3xl bg-card p-8 shadow-lg lg:sticky lg:top-8" data-form novalidate>
          <h2 class="font-display text-2xl font-semibold">Tus datos</h2>
          <p class="mt-1 text-sm text-muted-foreground" data-chosen>Primero elige un horario</p>

          <div class="mt-4">
            <label for="f-name" class="text-sm font-medium">Nombre</label>
            <input class={input} id="f-name" name="name" autocomplete="name" required maxlength="100" />
          </div>
          <div class="mt-4">
            <label for="f-email" class="text-sm font-medium">Email</label>
            <input class={input} id="f-email" name="email" type="email" autocomplete="email" required maxlength="255" />
          </div>
          <div class="mt-4">
            <label for="f-phone" class="text-sm font-medium">Teléfono</label>
            <input class={input} id="f-phone" name="phone" type="tel" autocomplete="tel" required maxlength="30" />
          </div>

          <div class="honeypot" aria-hidden="true">
            <label for="f-company">No rellenes este campo</label>
            <input id="f-company" name="company" tabindex="-1" autocomplete="off" />
          </div>

          <p class="mt-5 rounded-2xl bg-secondary p-4 text-xs leading-relaxed text-muted-foreground">
            <strong class="text-foreground">Protección de datos.</strong> Responsable: {TITULAR.nombre}. Finalidad:
            gestionar tu cita. Base: tu consentimiento. No se ceden a terceros; se borran 90 días después de la
            cita. Puedes ejercer tus derechos escribiendo al correo de contacto.{" "}
            <a href="/privacidad/" target="_blank" class="text-primary underline">Más información</a>.
          </p>

          <label class="mt-4 flex items-start gap-3 text-sm leading-snug">
            <input type="checkbox" name="consent" required class="mt-0.5 size-4 accent-[var(--primary)]" />
            <span>
              He leído la <a href="/privacidad/" target="_blank" class="text-primary underline">política de privacidad</a> y
              consiento el tratamiento de mis datos para gestionar la cita.
            </span>
          </label>

          <p data-form-error role="alert" hidden></p>

          <button
            class="mt-6 w-full rounded-full bg-primary py-3 font-semibold text-primary-foreground disabled:opacity-50"
            type="submit"
            data-submit
            disabled
          >
            Confirmar cita
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="flex min-h-screen items-center justify-center bg-secondary/60 px-6" data-step="done" hidden>
    <div class="max-w-md rounded-3xl bg-card p-10 text-center shadow-xl">
      <Icon name="lucide:circle-check" class="mx-auto size-14 text-primary" aria-hidden="true" />
      <h1 class="mt-4 font-display text-4xl font-medium">¡Cita reservada!</h1>
      <p class="mt-3 text-muted-foreground" data-done-when></p>
      <div class="mt-6 rounded-2xl bg-secondary p-4 text-left text-sm">
        <p>Guarda este enlace para cancelar o cambiar tu cita. Es personal: no lo compartas.</p>
        <div class="mt-3 flex gap-2">
          <input
            class="min-w-0 flex-1 rounded-xl border border-input bg-background px-3 py-2 text-xs"
            readonly
            data-manage-url
            aria-label="Enlace para gestionar tu cita"
          />
          <button type="button" class="rounded-full border border-primary px-4 py-2 text-xs font-semibold text-primary" data-copy>
            Copiar
          </button>
        </div>
        <a data-manage-link href="/cita/" class="mt-2 inline-block font-semibold text-primary underline">Ver mi cita</a>
      </div>
      <a href="/" class="mt-8 inline-block rounded-full bg-primary px-6 py-3 font-semibold text-primary-foreground">Volver a la web</a>
    </div>
  </div>
</Base>

<script>
  import { supabase, mensajeError } from "../lib/supabase";
  import { $, AVISO, h, showMessage } from "../lib/dom";
  import { fmtDay, fmtTime, groupByDay, type Slot } from "../lib/slots";

  const daysEl = $("[data-days]");
  const form = $<HTMLFormElement>("[data-form]");
  const chosen = $("[data-chosen]");
  const submit = $<HTMLButtonElement>("[data-submit]");
  const errorEl = $("[data-form-error]");
  let selected: Slot | null = null;

  const HORA = "rounded-full px-5 py-2 text-sm font-semibold transition";
  function claseHora(s: Slot | null, elegida: boolean) {
    if (s?.is_booked) return `${HORA} cursor-not-allowed bg-muted text-muted-foreground line-through`;
    if (elegida) return `${HORA} bg-primary text-primary-foreground ring-4 ring-primary/30`;
    return `${HORA} border border-primary text-primary hover:bg-primary hover:text-primary-foreground`;
  }

  async function load() {
    const { data, error } = await supabase()
      .from("slots")
      .select("id, starts_at, is_booked")
      .gt("starts_at", new Date().toISOString())
      .order("starts_at");

    daysEl.replaceChildren();
    if (error) {
      daysEl.append(h("p", { class: AVISO.error }, mensajeError(error)));
      return;
    }
    const slots = (data ?? []) as Slot[];
    if (!slots.some((s) => !s.is_booked)) {
      daysEl.append(
        h(
          "div",
          { class: "rounded-3xl bg-card p-8 text-center text-muted-foreground shadow-sm" },
          h("p", {}, "Aún no hay horarios publicados. Vuelve pronto o escríbeme por WhatsApp."),
        ),
      );
    }
    for (const list of groupByDay(slots)) {
      const times = h("div", { class: "mt-3 flex flex-wrap gap-2" });
      for (const s of list) {
        const btn = h(
          "button",
          {
            type: "button",
            class: claseHora(s, false),
            disabled: s.is_booked,
            "data-slot": true,
            "aria-pressed": selected?.id === s.id ? "true" : "false",
            "aria-label": `${fmtDay(s.starts_at)}, ${fmtTime(s.starts_at)}${s.is_booked ? " (ocupado)" : ""}`,
          },
          fmtTime(s.starts_at),
        );
        btn.addEventListener("click", () => select(s, btn));
        times.append(btn);
      }
      daysEl.append(
        h("div", {}, h("h2", { class: "font-display text-2xl font-semibold capitalize" }, fmtDay(list[0]!.starts_at)), times),
      );
    }
  }

  function select(s: Slot, btn: HTMLButtonElement) {
    selected = s;
    daysEl.querySelectorAll<HTMLButtonElement>("[data-slot]").forEach((b) => {
      if (b.disabled) return;
      b.setAttribute("aria-pressed", "false");
      b.className = claseHora(null, false);
    });
    btn.setAttribute("aria-pressed", "true");
    btn.className = claseHora(null, true);
    chosen.replaceChildren(
      "Hora elegida: ",
      h("strong", { class: "capitalize text-foreground" }, `${fmtDay(s.starts_at)}, ${fmtTime(s.starts_at)}`),
    );
    submit.disabled = false;
    if (window.matchMedia("(max-width: 900px)").matches) form.scrollIntoView({ behavior: "smooth" });
  }

  function validate(fd: FormData): string | null {
    const name = String(fd.get("name") ?? "").trim();
    const email = String(fd.get("email") ?? "").trim();
    const phone = String(fd.get("phone") ?? "").trim();
    if (!selected) return "Elige primero un horario.";
    if (name.length < 2) return "Escribe tu nombre.";
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return "Revisa tu correo electrónico.";
    if (phone.replace(/\D/g, "").length < 9) return "Revisa tu teléfono.";
    if (!fd.get("consent")) return "Necesitamos tu consentimiento para guardar la cita.";
    return null;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    if (String(fd.get("company") ?? "") !== "") return; // bot
    const problem = validate(fd);
    if (problem) return showMessage(errorEl, problem, "error", "mt-4");
    showMessage(errorEl, "");

    submit.disabled = true;
    submit.textContent = "Reservando…";
    const slot = selected!;
    const { data: token, error } = await supabase().rpc("book_slot", {
      _slot_id: slot.id,
      _name: String(fd.get("name")).trim(),
      _email: String(fd.get("email")).trim(),
      _phone: String(fd.get("phone")).trim(),
    });
    submit.textContent = "Confirmar cita";

    if (error || typeof token !== "string") {
      showMessage(errorEl, mensajeError(error), "error", "mt-4");
      selected = null;
      chosen.textContent = "Primero elige un horario";
      await load();
      return;
    }

    const url = `${location.origin}/cita/#${token}`;
    $("[data-step=choose]").hidden = true;
    $("[data-step=done]").hidden = false;
    $("[data-done-when]").replaceChildren(
      "Te esperamos el ",
      h("strong", { class: "text-foreground" }, fmtDay(slot.starts_at)),
      " a las ",
      h("strong", { class: "text-foreground" }, fmtTime(slot.starts_at)),
      ".",
    );
    $<HTMLInputElement>("[data-manage-url]").value = url;
    $<HTMLAnchorElement>("[data-manage-link]").href = url;
    window.scrollTo({ top: 0 });
  });

  $("[data-copy]").addEventListener("click", async (e) => {
    const input = $<HTMLInputElement>("[data-manage-url]");
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(input.value);
      btn.textContent = "Copiado";
    } catch {
      input.select();
    }
  });

  load();
</script>

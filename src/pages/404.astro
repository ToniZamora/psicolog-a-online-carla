---
import Base from "../layouts/Base.astro";
---

<Base title="Página no encontrada · ConCiencia Psicología" noindex bare>
  <div class="flex min-h-screen items-center justify-center bg-background px-4">
    <div class="max-w-md text-center">
      <h1 class="text-7xl font-bold text-foreground">404</h1>
      <h2 class="mt-4 text-xl font-semibold text-foreground">Página no encontrada</h2>
      <p class="mt-2 text-sm text-muted-foreground">La página que buscas no existe o se ha movido.</p>
      <div class="mt-6">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Ir al inicio
        </a>
      </div>
    </div>
  </div>
</Base>

<script>
  // Los enlaces de la web anterior tenían la forma /cita/<token>. Los pasamos al formato
  // nuevo (/cita/#<token>) para que nadie pierda el acceso a su cita.
  const m = location.pathname.match(/^\/cita\/([0-9a-f-]{36})\/?$/i);
  if (m) location.replace(`/cita/#${m[1]}`);
</script>

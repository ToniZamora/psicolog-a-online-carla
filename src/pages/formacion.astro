---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import { CARLA, FORMACION } from "../data/site";
---

<Base
  title="Formación de Carla Castellano, psicóloga · ConCiencia"
  migas={[{ nombre: "Formación", href: "/formacion/" }]}
  description="Formación de Carla Castellano: Máster en Psicología General Sanitaria, Máster en Psicología Infantil y Juvenil y especialización en trauma."
>
  <PageIntro eyebrow="Formación" title="Formación profesional," accent="al servicio de cada persona.">
    <p>
      La psicología se aprende también formándose de forma continua. Esta es la base académica con la
      que trabajo cada día.
    </p>
  </PageIntro>

  <section class="section training">
    <div class="wrap-narrow">
      <ol class="timeline">
        {
          FORMACION.map((f) => (
            <li>
              <span class="dot" aria-hidden="true">
                <Icon name="lucide:graduation-cap" />
              </span>
              <div>
                <h2>{f.titulo}</h2>
                {f.centro && <p class="centro">{f.centro}</p>}
                <p class="muted">{f.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="colegiada">
        <Icon name="lucide:shield-check" aria-hidden="true" />
        <span>
          {CARLA.cargo} colegiada en el COPCV con el número <strong>{CARLA.colegiada}</strong>.
        </span>
      </p>

      <a class="link-arrow back" href="/">
        <Icon name="lucide:arrow-left" aria-hidden="true" />
        Volver al inicio
      </a>
    </div>
  </section>
</Base>

<style>
  .training {
    padding-top: clamp(40px, 6vw, 72px);
  }

  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 25px;
    top: 26px;
    bottom: 26px;
    width: 1px;
    background: var(--sage-2);
  }

  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 24px;
    padding-bottom: 44px;
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .dot {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--sage-2);
    border-radius: 50%;
    background: var(--surface);
    color: var(--green);
  }

  .dot :global(svg) {
    width: 24px;
    height: 24px;
  }

  .timeline h2 {
    padding-top: 8px;
    font-size: clamp(1.35rem, 2.4vw, 1.65rem);
    line-height: 1.25;
  }

  .centro {
    margin-top: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clay);
  }

  .timeline .muted {
    margin-top: 10px;
  }

  .colegiada {
    display: flex;
    gap: 14px;
    align-items: center;
    margin: 56px 0 40px;
    padding: 20px 24px;
    border-radius: var(--radius);
    background: var(--sage);
    color: var(--green-deep);
  }

  .colegiada :global(svg) {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }
</style>

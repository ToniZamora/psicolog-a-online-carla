---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import { FORMACION } from "../data/site";
---

<Base
  title="Formación de Carla Castellano, psicóloga · ConCiencia"
  description="Formación de Carla Castellano: Máster en Psicología General Sanitaria, Máster en Psicología Infantil y Juvenil y especialización en trauma."
  migas={[{ nombre: "Formación", href: "/formacion/" }]}
>
  <div class="min-h-screen bg-background text-foreground">
    <section class="editorial-intro pb-16 pt-10 md:pb-20 md:pt-14">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="fade-up flex items-center justify-center gap-3 text-xs font-semibold uppercase text-primary">
          <span class="h-px w-10 bg-primary"></span>
          Formación
          <span class="h-px w-10 bg-primary"></span>
        </p>
        <h1 class="fade-up-delay-1 mt-6 font-display text-4xl font-normal leading-tight sm:text-5xl">
          Formación profesional,
          <span class="mt-4 block text-xl italic text-primary sm:text-2xl">al servicio de cada persona.</span>
        </h1>
        <p class="fade-up-delay-2 mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
          La psicología se aprende también formándose de forma continua. Esta es la base académica con la
          que trabajo cada día.
        </p>
      </div>
    </section>

    <section class="pb-20 md:pb-28">
      <div class="mx-auto max-w-4xl px-6">
        <div class="border-t border-border">
          {
            FORMACION.map(({ titulo, centro, texto }) => (
              <article class="border-b border-border py-8 md:py-10">
                <div class="flex items-start gap-5">
                  <div class="mt-1 inline-flex shrink-0 text-primary">
                    <Icon name="lucide:graduation-cap" class="size-6" stroke-width="1.4" aria-hidden="true" />
                  </div>
                  <div>
                    <h2 class="font-display text-2xl font-medium leading-snug">{titulo}</h2>
                    {centro && <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-primary">{centro}</p>}
                    <p class="mt-3 text-left leading-relaxed text-muted-foreground lg:text-justify">{texto}</p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-card py-16 md:py-20">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-primary underline-offset-4 hover:underline">
          <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
          Volver al inicio
        </a>
      </div>
    </section>
  </div>
</Base>

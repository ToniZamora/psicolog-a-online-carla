---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import FrameGuard from "../components/FrameGuard.astro";
---

<Base title="Gestionar mi cita · ConCiencia Psicología" description="Cancela o cambia la hora de tu cita." noindex bare>
  <FrameGuard />
  <div class="flex min-h-screen items-center justify-center bg-secondary/60 px-6 py-12">
    <div class="w-full max-w-xl rounded-3xl bg-card p-8 shadow-xl md:p-10">
      <Icon name="lucide:calendar-check" class="size-10 text-primary" aria-hidden="true" />
      <div data-view aria-live="polite">
        <p class="mt-4 text-muted-foreground">Cargando…</p>
      </div>
    </div>
  </div>
</Base>

<script>
  import { supabase, mensajeError } from "../lib/supabase";
  import { AVISO, confirmar, h } from "../lib/dom";

  const H1 = "mt-4 font-display text-4xl font-medium";
  const TEXTO = "mt-3 text-lg text-muted-foreground";
  const BOTON = "inline-block rounded-full bg-primary px-6 py-3 font-semibold text-primary-foreground";
  import { UUID_RE, fmtDay, fmtTime, groupByDay, type Slot } from "../lib/slots";

  const view = document.querySelector<HTMLElement>("[data-view]")!;
  // El token va en el fragmento (#) para que nunca llegue a servidores ni a cabeceras Referer.
  const token = decodeURIComponent(location.hash.slice(1));

  function render(...nodes: Node[]) {
    view.replaceChildren(...nodes);
  }

  function invalid() {
    render(
      h("p", { class: "mt-4 text-lg" }, "Este enlace no es válido o la cita ya fue cancelada."),
      h("a", { class: `mt-6 ${BOTON}`, href: "/" }, "Volver a la web"),
    );
  }

  async function load() {
    if (!UUID_RE.test(token)) return invalid();
    const { data, error } = await supabase().rpc("get_booking_by_token", { _token: token });
    const cita = (data as { name: string; starts_at: string }[] | null)?.[0];
    if (error || !cita) return invalid();

    const futura = new Date(cita.starts_at) > new Date();
    const firstName = cita.name.split(" ")[0] ?? "";
    const actions = h("div", { class: "mt-8 flex flex-wrap gap-3" });
    const message = h("p", { class: `mt-6 ${AVISO.error}`, role: "alert", hidden: true });
    const slotsBox = h("div", { class: "mt-8 space-y-5" });

    if (futura) {
      const change = h("button", { type: "button", class: BOTON }, "Cambiar hora");
      const cancel = h(
        "button",
        { type: "button", class: "rounded-full border border-border px-6 py-3 font-semibold text-muted-foreground hover:text-destructive" },
        "Cancelar cita",
      );
      change.addEventListener("click", () => openChange(slotsBox, message));
      cancel.addEventListener("click", () => doCancel(message));
      actions.append(change, cancel);
    }

    render(
      h("h1", { class: H1 }, `Hola, ${firstName}`),
      h(
        "p",
        { class: TEXTO },
        "Tu cita es el ",
        h("strong", { class: "capitalize text-foreground" }, fmtDay(cita.starts_at)),
        " a las ",
        h("strong", {}, fmtTime(cita.starts_at)),
        ".",
      ),
      futura ? actions : h("p", { class: "mt-6 text-sm text-muted-foreground" }, "Esta cita ya ha pasado."),
      message,
      slotsBox,
    );
  }

  async function openChange(box: HTMLElement, message: HTMLElement) {
    const { data, error } = await supabase()
      .from("slots")
      .select("id, starts_at, is_booked")
      .gt("starts_at", new Date().toISOString())
      .eq("is_booked", false)
      .order("starts_at");
    box.replaceChildren();
    if (error) {
      message.hidden = false;
      message.textContent = mensajeError(error);
      return;
    }
    const slots = (data ?? []) as Slot[];
    if (!slots.length) {
      box.append(h("p", { class: "text-muted-foreground" }, "No hay otros huecos libres ahora mismo."));
      return;
    }

    for (const list of groupByDay(slots)) {
      const times = h("div", { class: "mt-2 flex flex-wrap gap-2" });
      for (const s of list) {
        const btn = h(
          "button",
          {
            type: "button",
            class:
              "rounded-full border border-primary px-4 py-1.5 text-sm font-semibold text-primary hover:bg-primary hover:text-primary-foreground",
          },
          fmtTime(s.starts_at),
        );
        btn.addEventListener("click", () => move(s, message));
        times.append(btn);
      }
      box.append(h("div", {}, h("h2", { class: "font-display text-xl font-semibold capitalize" }, fmtDay(list[0]!.starts_at)), times));
    }
  }

  async function move(s: Slot, message: HTMLElement) {
    const ok = await confirmar(
      `¿Cambiar tu cita al ${fmtDay(s.starts_at)} a las ${fmtTime(s.starts_at)}?`,
      "Sí, cambiar",
    );
    if (!ok) return;
    const { error } = await supabase().rpc("reschedule_booking", { _token: token, _new_slot_id: s.id });
    if (error) {
      message.hidden = false;
      message.textContent = mensajeError(error);
      return;
    }
    await load();
    view.prepend(h("p", { class: `mt-4 ${AVISO.ok}` }, "Cita cambiada."));
  }

  async function doCancel(message: HTMLElement) {
    const ok = await confirmar("¿Seguro que quieres cancelar tu cita? Se borrarán tus datos de la reserva.", "Sí, cancelar");
    if (!ok) return;
    const { error } = await supabase().rpc("cancel_booking_by_token", { _token: token });
    if (error) {
      message.hidden = false;
      message.textContent = mensajeError(error);
      return;
    }
    history.replaceState(null, "", location.pathname);
    render(
      h("h1", { class: H1 }, "Cita cancelada"),
      h("p", { class: "mt-3 text-muted-foreground" }, "Tus datos de la reserva se han borrado. Cuando quieras, puedes reservar otra."),
      h("a", { class: `mt-6 ${BOTON}`, href: "/reservar/" }, "Reservar de nuevo"),
    );
  }

  load();
</script>

---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import ContactButtons from "../components/ContactButtons.astro";
import { CONTACTO } from "../data/site";

const detalles = [
  { icono: "lucide:mail", titulo: "Correo electrónico", valor: CONTACTO.email },
  { icono: "lucide:phone", titulo: "Teléfono", valor: `(${CONTACTO.telefono})` },
  { icono: "lucide:clock", titulo: "Horario de atención", valor: CONTACTO.horario },
  { icono: "lucide:map-pin", titulo: "Direcciones de consulta", valor: CONTACTO.modalidades },
];
---

<Base
  title="Contacto y primera cita · ConCiencia Psicología"
  description="Contacta con Carla Castellano, psicóloga sanitaria. Atención presencial en Valencia, Sagunto y Benisanó, y sesiones online. Escríbeme por WhatsApp o correo."
  migas={[{ nombre: "Contacto", href: "/contacto/" }]}
>
  <PageIntro label="Contacto" title="Un espacio para hablar contigo">
    <p>
      Si quieres consultar tus dudas o dar un primer paso, puedes escribirme por el medio con el que te
      sientas más a gusto.
    </p>
  </PageIntro>
  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-6">
      <dl class="grid gap-x-14 sm:grid-cols-2">
        {
          detalles.map(({ icono, titulo, valor }) => (
            <div class="border-b border-border py-8">
              <dt class="flex items-center gap-3 font-display text-xl text-primary">
                <Icon name={icono} class="size-5 shrink-0" stroke-width="1.5" aria-hidden="true" />
                {titulo}
              </dt>
              <dd class="mt-4 break-words leading-relaxed text-muted-foreground">{valor}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-8 text-center leading-relaxed text-muted-foreground">
        Atención online y presencial en Benisanó, Sagunto y Valencia.
      </p>
    </div>
  </section>
  <section class="border-t border-border bg-secondary py-12 md:py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="font-display text-3xl text-foreground">¿Hablamos?</h2>
      <p class="mx-auto mt-5 max-w-xl leading-relaxed text-foreground">
        No necesitas tenerlo todo claro para contactar conmigo. Si prefieres no utilizar tu número personal
        de WhatsApp, puedes escribirme por correo.
      </p>
      <div class="mt-7">
        <ContactButtons />
      </div>
    </div>
  </section>
</Base>

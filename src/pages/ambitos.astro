---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import ContactButtons from "../components/ContactButtons.astro";
import { SERVICIOS } from "../data/site";
import { ambitosVisibles } from "../lib/ambitos";
import { btn } from "../lib/ui";

const conPagina = new Set((await ambitosVisibles()).map((e) => e.id));
---

<Base
  title="Ámbitos de terapia psicológica · ConCiencia Psicología"
  description="Terapia para ansiedad, depresión, trauma, autoestima, perfeccionismo, relaciones e infancia en Valencia, Sagunto, Benisanó y online."
  migas={[{ nombre: "Ámbitos de intervención", href: "/ambitos/" }]}
>
  <PageIntro label="Ámbitos de intervención" title="¿En qué puedo ayudarte?">
    <p>
      Distintas necesidades, una misma mirada: comprender tu historia y generar cambio adaptándome siempre
      a ti.
    </p>
  </PageIntro>
  <section class="py-12 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-x-14 px-6 sm:grid-cols-2">
      {
        SERVICIOS.map((s, i) => (
          <article id={s.id} class="scroll-mt-28 border-b border-border py-8 md:py-10">
            <div class="flex items-center justify-between text-primary">
              <Icon name={s.icono} class="size-7" stroke-width="1.4" aria-hidden="true" />
              <span class="font-display text-sm text-muted-foreground">0{i + 1}</span>
            </div>
            <h2 class="mt-5 font-display text-2xl leading-snug">
              {conPagina.has(s.id) ? <a href={`/ambitos/${s.id}/`} class="hover:text-primary">{s.titulo}</a> : s.titulo}
            </h2>
            <p class="mt-4 leading-relaxed text-muted-foreground">{s.texto}</p>
            {conPagina.has(s.id) && (
              <a href={`/ambitos/${s.id}/`} class={btn({ variant: "link", class: "mt-3 h-auto px-0 py-1" })}>
                Leer más
                <Icon name="lucide:arrow-up-right" aria-hidden="true" />
              </a>
            )}
          </article>
        ))
      }
    </div>
    <div class="mx-auto mt-14 max-w-3xl px-6">
      <div class="rounded-[var(--radius)] border border-border bg-secondary/60 px-7 py-10 text-center md:px-12">
        <p class="font-display text-2xl leading-snug text-foreground md:text-[1.75rem]">¿No tienes claro qué necesitas?</p>
        <p class="mx-auto mt-4 max-w-xl leading-relaxed text-foreground">
          Escríbeme sin compromiso: hablamos de lo que te está pasando y vemos si puedo ayudarte. Y si lo
          tuyo queda fuera de mis competencias, te ayudo a encontrar un profesional que sí pueda
          acompañarte.
        </p>
        <div class="mt-7">
          <ContactButtons />
        </div>
      </div>
    </div>
    <div class="mx-auto mt-12 max-w-6xl px-6">
      <a href="/" class={btn({ variant: "link", class: "px-0" })}>
        <Icon name="lucide:arrow-left" aria-hidden="true" />
        Volver al inicio
      </a>
    </div>
  </section>
</Base>

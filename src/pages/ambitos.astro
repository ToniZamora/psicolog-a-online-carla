---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import ContactButtons from "../components/ContactButtons.astro";
import { SERVICIOS } from "../data/site";
import { ambitosVisibles } from "../lib/ambitos";

const conPagina = new Set((await ambitosVisibles()).map((e) => e.id));
---

<Base
  title="Ámbitos de terapia psicológica · ConCiencia Psicología"
  migas={[{ nombre: "Ámbitos de intervención", href: "/ambitos/" }]}
  description="Terapia para ansiedad, depresión, trauma, autoestima, perfeccionismo, relaciones e infancia en Valencia, Sagunto, Benisanó y online."
>
  <PageIntro eyebrow="Ámbitos de intervención" title="¿En qué puedo ayudarte?">
    <p>
      Distintas necesidades, una misma mirada: comprender tu historia y generar cambio adaptándome
      siempre a ti.
    </p>
  </PageIntro>

  <section class="section areas-section">
    <div class="wrap">
      <ol class="areas">
        {
          SERVICIOS.map((s, i) => (
            <li id={s.id} class="area">
              <div class="area-top">
                <span class="area-icon">
                  <Icon name={s.icono} aria-hidden="true" />
                </span>
                <span class="area-num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </div>
              <h2>{s.titulo}</h2>
              <p class="muted">{s.texto}</p>
              {conPagina.has(s.id) && (
                <a class="link-arrow area-more" href={`/ambitos/${s.id}/`}>
                  Leer más
                  <Icon name="lucide:arrow-up-right" aria-hidden="true" />
                </a>
              )}
            </li>
          ))
        }
      </ol>

      <div class="unsure card">
        <h2>¿No tienes claro qué necesitas?</h2>
        <p class="muted">
          Escríbeme sin compromiso: hablamos de lo que te está pasando y vemos si puedo ayudarte. Y
          si lo tuyo queda fuera de mis competencias, te ayudo a encontrar un profesional que sí pueda
          acompañarte.
        </p>
        <ContactButtons center />
      </div>
    </div>
  </section>
</Base>

<style>
  .areas-section {
    padding-top: clamp(40px, 6vw, 72px);
  }

  .areas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .area {
    display: flex;
    flex-direction: column;
    padding: 30px 28px 32px;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    scroll-margin-top: 110px;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .area:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .area:target {
    border-color: var(--clay);
    box-shadow: 0 0 0 4px var(--clay-soft);
  }

  .area-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }

  .area-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--sage);
    color: var(--green);
  }

  .area-icon :global(svg) {
    width: 26px;
    height: 26px;
  }

  .area-num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--clay);
  }

  .area h2 {
    font-size: 1.4rem;
    line-height: 1.25;
  }

  .area p {
    margin-top: 12px;
    font-size: 0.99rem;
  }

  .area-more {
    margin-top: auto;
    padding-top: 18px;
  }

  .unsure {
    max-width: 760px;
    margin: clamp(48px, 7vw, 80px) auto 0;
    text-align: center;
    background: var(--sage);
    border-color: var(--sage-2);
  }

  .unsure h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .unsure p {
    max-width: 56ch;
    margin: 14px auto 28px;
    color: var(--ink-soft);
  }

  @media (max-width: 960px) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .areas {
      grid-template-columns: 1fr;
    }
  }
</style>

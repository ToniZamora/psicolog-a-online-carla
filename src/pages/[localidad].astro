---
// Páginas de SEO local: /psicologa-valencia/, /psicologa-sagunto/, /psicologa-benisano/ y
// /psicologia-online/. Solo usan datos reales de src/data/site.ts.
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import ContactButtons from "../components/ContactButtons.astro";
import Faq from "../components/Faq.astro";
import {
  CARLA,
  CONTACTO,
  ONLINE,
  PREGUNTAS,
  SERVICIOS,
  SITE,
  TARIFAS,
  UBICACIONES,
  mapsSearchUrl,
} from "../data/site";
import { ID_CONSULTA } from "../lib/schema";
import { btn } from "../lib/ui";

type Lugar = {
  slug: string;
  nombre: string;
  tarifa: number;
  centro?: string;
  mapa?: string;
};

export const getStaticPaths = (() => {
  const lugares: Lugar[] = [
    ...UBICACIONES.map((u) => ({ slug: u.slug, nombre: u.nombre, tarifa: u.tarifa, centro: u.centro, mapa: mapsSearchUrl(u) })),
    { ...ONLINE },
  ];
  return lugares.map((lugar) => ({ params: { localidad: lugar.slug }, props: { lugar, lugares } }));
}) satisfies GetStaticPaths;

const { lugar, lugares } = Astro.props as { lugar: Lugar; lugares: Lugar[] };
const online = lugar.slug === ONLINE.slug;
const tarifa = TARIFAS[lugar.tarifa]!;
const url = `${SITE.url}/${lugar.slug}/`;

const h1 = online ? "Psicóloga online" : `Psicóloga en ${lugar.nombre}`;
const title = online
  ? "Psicóloga online · Terapia a distancia · ConCiencia"
  : `Psicóloga en ${lugar.nombre} · Carla Castellano · ConCiencia`;
const description = online
  ? `Terapia psicológica online con Carla Castellano, psicóloga sanitaria colegiada ${CARLA.colegiada}. Sesiones de 50 minutos desde donde estés.`
  : `Psicóloga sanitaria en ${lugar.nombre} (${lugar.centro}). Ansiedad, depresión, trauma, autoestima e infancia. Carla Castellano, colegiada ${CARLA.colegiada}.`;

const otros = lugares.filter((l) => l.slug !== lugar.slug);
const preguntas = PREGUNTAS.filter((q) =>
  ["¿Cuánto dura una sesión?", "¿Cómo pido una primera cita?", "¿Atiendes a niños y adolescentes?", "¿Estás colegiada?"].includes(q.p),
);

const precioNum = (p: string) => Number(p.replace(/[^\d]/g, ""));
const schema = [
  {
    "@type": "Service",
    "@id": `${url}#servicio`,
    name: h1,
    serviceType: "Psicología sanitaria",
    url,
    provider: { "@id": ID_CONSULTA },
    areaServed: online ? { "@type": "Country", name: "España" } : { "@type": "City", name: lugar.nombre },
    ...(online
      ? { availableChannel: { "@type": "ServiceChannel", name: "Sesiones online", serviceUrl: url } }
      : {
          availableChannel: {
            "@type": "ServiceChannel",
            name: `Consulta presencial en ${lugar.nombre}`,
            serviceLocation: {
              "@type": "Place",
              name: lugar.centro,
              address: {
                "@type": "PostalAddress",
                addressLocality: lugar.nombre,
                addressRegion: "Valencia",
                addressCountry: "ES",
              },
            },
          },
        }),
    offers: tarifa.precios.map((p) => ({
      "@type": "Offer",
      name: p.concepto,
      price: precioNum(p.precio),
      priceCurrency: "EUR",
    })),
  },
];
---

<Base title={title} description={description} schema={schema} migas={[{ nombre: h1, href: `/${lugar.slug}/` }]}>
  <PageIntro label={online ? "Terapia online" : `Consulta en ${lugar.nombre}`} title={h1}>
    {
      online ? (
        <p>
          {CARLA.nombre}, psicóloga general sanitaria colegiada {CARLA.colegiada}. Sesiones de psicología
          online con la misma cercanía que en consulta, desde donde estés.
        </p>
      ) : (
        <p>
          {CARLA.nombre}, psicóloga general sanitaria colegiada {CARLA.colegiada}. Atención presencial en{" "}
          {lugar.nombre}, en {lugar.centro}.
        </p>
      )
    }
  </PageIntro>

  <section class="py-12 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 md:grid-cols-[1.3fr_0.9fr] md:gap-16">
      <div>
        <p class="text-xs font-semibold uppercase text-primary">Cómo trabajo</p>
        <p class="mt-5 text-left leading-relaxed text-muted-foreground md:text-justify">
          Un espacio de confianza, cercano y acogedor, donde poder hablar de lo que te preocupa y abordar
          tus dificultades con respeto, comprensión y sin juicios. Mi forma de trabajar parte de una mirada
          integradora, que combina diferentes enfoques y herramientas psicológicas para ofrecer un
          acompañamiento adaptado a las necesidades, circunstancias y momento vital de cada persona.
        </p>
        <p class="mt-4 text-left leading-relaxed text-muted-foreground md:text-justify">
          Mis intervenciones se basan principalmente en la terapia cognitivo-conductual, las terapias de
          tercera generación y sistémica, incorporando también una perspectiva de trauma.
          {online && " En las sesiones online el enfoque y el acompañamiento son los mismos que en consulta presencial."}
        </p>
        <a href="/sobre-mi/" class={btn({ variant: "link", class: "mt-4 h-auto px-0 py-2" })}>
          Conoce más sobre mí
          <Icon name="lucide:arrow-up-right" aria-hidden="true" />
        </a>

        <h2 class="mt-12 font-display text-3xl leading-tight">
          En qué puedo ayudarte{online ? " online" : ` en ${lugar.nombre}`}
        </h2>
        <div class="mt-6 grid gap-x-10 sm:grid-cols-2">
          {
            SERVICIOS.map((s) => (
              <a
                href={`/ambitos/${s.id}/`}
                class="flex items-center gap-3 border-b border-border py-4 leading-snug hover:text-primary"
              >
                <Icon name={s.icono} class="size-5 shrink-0 text-primary" stroke-width="1.4" aria-hidden="true" />
                {s.titulo}
              </a>
            ))
          }
        </div>
      </div>

      <aside class="h-fit rounded-3xl border border-border bg-card p-7 shadow-sm md:sticky md:top-28 md:p-9" aria-labelledby="info-title">
        <h2 id="info-title" class="font-display text-2xl font-semibold text-primary">Información práctica</h2>
        <dl class="mt-6 divide-y divide-border border-y border-border text-sm">
          {
            !online && (
              <div class="flex justify-between gap-4 py-4">
                <dt class="text-muted-foreground">Centro</dt>
                <dd class="text-right">
                  <a href={lugar.mapa} target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-4">
                    {lugar.centro}
                  </a>
                </dd>
              </div>
            )
          }
          <div class="flex justify-between gap-4 py-4">
            <dt class="text-muted-foreground">Duración</dt>
            <dd class="text-right">50 minutos</dd>
          </div>
          <div class="flex justify-between gap-4 py-4">
            <dt class="text-muted-foreground">Horario</dt>
            <dd class="text-right">{CONTACTO.horario}</dd>
          </div>
          {
            tarifa.precios.map((p) => (
              <div class="flex items-center justify-between gap-4 py-4">
                <dt class="text-muted-foreground">{p.concepto}</dt>
                <dd class="font-display text-2xl font-semibold">{p.precio}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-7">
          <ContactButtons class="flex-col" />
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-border bg-card py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <p class="text-xs font-semibold uppercase text-primary">Preguntas frecuentes</p>
      <div class="mt-6">
        <Faq preguntas={preguntas} />
      </div>
      <a href="/preguntas-frecuentes/" class={btn({ variant: "link", class: "mt-4 h-auto px-0 py-2" })}>
        Ver todas las preguntas
        <Icon name="lucide:arrow-up-right" aria-hidden="true" />
      </a>
    </div>
  </section>

  <section class="border-t border-border bg-secondary/50 py-16 md:py-20" aria-labelledby="otros-title">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold uppercase text-primary">Ubicaciones</p>
      <h2 id="otros-title" class="mt-4 font-display text-3xl leading-tight md:text-4xl">También atiendo</h2>
      <div class="mt-8 divide-y divide-border border-y border-border">
        {
          otros.map((o) => (
            <a href={`/${o.slug}/`} class="flex items-center justify-between gap-3 py-5 hover:text-primary">
              <span class="flex items-center gap-3">
                <Icon name={o.slug === ONLINE.slug ? "lucide:video" : "lucide:map-pin"} class="size-6 text-primary" aria-hidden="true" />
                {o.slug === ONLINE.slug ? "Psicóloga online" : `Psicóloga en ${o.nombre}`}
              </span>
              <Icon name="lucide:arrow-up-right" class="size-6 text-primary" aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

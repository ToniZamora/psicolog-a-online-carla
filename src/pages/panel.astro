---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import FrameGuard from "../components/FrameGuard.astro";

const input = "mt-1 rounded-xl border border-input bg-background px-3 py-2";
---

<Base title="Panel de horarios · ConCiencia Psicología" description="Gestión privada de horarios y citas." noindex bare>
  <FrameGuard />
  <template data-trash><Icon name="lucide:trash-2" class="size-4" aria-hidden="true" /></template>

  <div class="min-h-screen bg-secondary/40" data-panel hidden>
    <div class="mx-auto max-w-5xl px-6 py-10">
      <div class="flex items-center justify-between">
        <h1 class="font-display text-4xl font-medium">Mis horarios</h1>
        <button type="button" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary" data-logout>
          <Icon name="lucide:log-out" class="size-4" aria-hidden="true" /> Salir
        </button>
      </div>

      <form class="mt-8 flex flex-wrap items-end gap-4 rounded-3xl bg-card p-6 shadow-sm" data-add>
        <div>
          <label for="a-date" class="block text-sm font-medium">Día</label>
          <input class={input} id="a-date" name="date" type="date" required />
        </div>
        <div>
          <label for="a-from" class="block text-sm font-medium">Desde</label>
          <input class={input} id="a-from" name="from" type="time" value="10:00" required />
        </div>
        <div>
          <label for="a-to" class="block text-sm font-medium">Hasta</label>
          <input class={input} id="a-to" name="to" type="time" value="14:00" required />
        </div>
        <button type="submit" class="rounded-full bg-primary px-6 py-2.5 font-semibold text-primary-foreground">Añadir horarios</button>
        <p class="w-full text-xs text-muted-foreground">Se crean sesiones de 50 min cada hora. Repite para añadir tarde u otros días.</p>
        <p data-add-msg role="status" hidden></p>
      </form>

      <div class="mt-8 space-y-6" data-list aria-live="polite"></div>
    </div>
  </div>

  <div class="p-10 text-center" data-denied hidden>
    Esta cuenta no tiene acceso al panel.
    <button type="button" class="text-primary underline" data-logout>Salir</button>
  </div>
</Base>

<script>
  import { supabase, mensajeError } from "../lib/supabase";
  import { $, AVISO, confirmar, h, showMessage } from "../lib/dom";
  import { fmtDay, fmtTime, generateSlots, groupByDay } from "../lib/slots";

  type Row = {
    id: string;
    starts_at: string;
    is_booked: boolean;
    bookings: { id: string; name: string; email: string; phone: string } | null;
  };

  const sb = supabase();
  const list = $("[data-list]");
  const addMsg = $("[data-add-msg]");
  const trash = $<HTMLTemplateElement>("[data-trash]");

  async function guard() {
    const { data } = await sb.auth.getSession();
    if (!data.session) return location.replace("/acceso/");
    const { data: admin } = await sb.rpc("is_admin");
    if (admin !== true) {
      $("[data-denied]").hidden = false;
      return;
    }
    $("[data-panel]").hidden = false;
    load();
  }

  async function load() {
    const { data, error } = await sb
      .from("slots")
      .select("id, starts_at, is_booked, bookings(id, name, email, phone)")
      .gt("starts_at", new Date(Date.now() - 86_400_000).toISOString())
      .order("starts_at");
    list.replaceChildren();
    if (error) {
      list.append(h("p", { class: AVISO.error }, mensajeError(error)));
      return;
    }
    const rows = (data ?? []) as unknown as Row[];
    if (!rows.length) {
      list.append(h("p", { class: "text-muted-foreground" }, "No hay horarios próximos."));
      return;
    }
    for (const day of groupByDay(rows)) {
      const ul = h("ul", { class: "mt-3 divide-y divide-border" });
      for (const r of day) ul.append(row(r));
      list.append(
        h(
          "div",
          { class: "rounded-3xl bg-card p-6 shadow-sm" },
          h("h2", { class: "font-display text-2xl font-semibold capitalize" }, fmtDay(day[0]!.starts_at)),
          ul,
        ),
      );
    }
  }

  function row(r: Row) {
    const b = r.bookings;
    let info: HTMLElement;
    if (b) {
      const cancel = h("button", { type: "button", class: "ml-3 text-xs text-primary hover:underline" }, "Cancelar cita");
      cancel.addEventListener("click", async () => {
        if (!(await confirmar(`¿Cancelar la cita de ${b.name}? El hueco quedará libre.`, "Cancelar cita"))) return;
        await sb.from("bookings").delete().eq("id", b.id);
        load();
      });
      info = h(
        "span",
        { class: "flex-1 text-sm" },
        h("strong", {}, b.name),
        " · ",
        h("a", { href: `mailto:${b.email}`, class: "hover:underline" }, b.email),
        " · ",
        h("a", { href: `tel:${b.phone.replace(/[^\d+]/g, "")}`, class: "hover:underline" }, b.phone),
        cancel,
      );
    } else {
      info = h("span", { class: "flex-1 text-sm text-muted-foreground" }, "Libre");
    }

    const del = h("button", {
      type: "button",
      class: "text-muted-foreground hover:text-destructive",
      "aria-label": `Borrar horario de las ${fmtTime(r.starts_at)}`,
    });
    del.append(trash.content.cloneNode(true));
    del.addEventListener("click", async () => {
      const texto = b ? `Esta hora la tiene ${b.name}. ¿Cancelar y borrar?` : "¿Borrar este horario?";
      if (!(await confirmar(texto, "Borrar"))) return;
      await sb.from("slots").delete().eq("id", r.id);
      load();
    });

    return h("li", { class: "flex flex-wrap items-center gap-4 py-3" }, h("span", { class: "w-16 font-semibold" }, fmtTime(r.starts_at)), info, del);
  }

  $<HTMLFormElement>("[data-add]").addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(e.currentTarget as HTMLFormElement);
    const slots = generateSlots(String(fd.get("date")), String(fd.get("from")), String(fd.get("to")));
    if (!slots.length) return showMessage(addMsg, "El rango es demasiado corto", "error", "w-full");
    const { error } = await sb.from("slots").upsert(slots, { onConflict: "starts_at", ignoreDuplicates: true });
    if (error) return showMessage(addMsg, mensajeError(error), "error", "w-full");
    showMessage(addMsg, `${slots.length} horarios añadidos`, "ok", "w-full");
    load();
  });

  document.querySelectorAll("[data-logout]").forEach((b) =>
    b.addEventListener("click", async () => {
      await sb.auth.signOut();
      location.replace("/");
    }),
  );

  guard();
</script>

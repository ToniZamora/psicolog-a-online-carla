---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import ContactButtons from "../components/ContactButtons.astro";
import ConsultationMap from "../components/ConsultationMap.astro";
import retrato from "../assets/carla-retrato.jpg";
import { CARLA, PREGUNTAS, SERVICIOS } from "../data/site";
import { consulta, personaCarla, preguntasFrecuentes } from "../lib/schema";
import Faq from "../components/Faq.astro";
import { ambitosVisibles } from "../lib/ambitos";

const conPagina = new Set((await ambitosVisibles()).map((e) => e.id));

const schema = [personaCarla(), consulta(), preguntasFrecuentes(PREGUNTAS.slice(0, 5))];
---

<Base title="Psicóloga en Valencia, Sagunto y Benisanó · ConCiencia" schema={schema}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow reveal">Psicóloga sanitaria · Presencial y online</p>
        <h1 class="hero-title reveal reveal-1">Con<em>Ciencia</em></h1>
        <p class="hero-quote reveal reveal-2">
          Un lugar donde encontrar apoyo para comprenderte y avanzar hacia aquello que necesitas.
        </p>
        <p class="hero-text reveal reveal-2">
          Carla Castellano es psicóloga sanitaria y ofrece atención presencial en Valencia, Sagunto y
          Benisanó, además de sesiones online. En ConCiencia Psicología encontrarás un espacio de
          confianza, cercano y acogedor, donde poder hablar de lo que te preocupa y abordar tus
          dificultades con respeto, comprensión y sin juicios.
        </p>
        <div class="btn-row hero-actions reveal reveal-3">
          <a class="btn" href="/contacto/">
            Pide tu primera cita
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </a>
          <a class="btn btn-outline" href="/ambitos/">Ámbitos de intervención</a>
        </div>
      </div>

      <figure class="portrait reveal reveal-2">
        <svg class="blob blob-sage" viewBox="0 0 200 200" aria-hidden="true">
          <path
            fill="currentColor"
            d="M44.7-61.3C56.9-52.4 64.8-37.6 69.6-21.6 74.4-5.6 76.1 11.6 70.1 25.4 64.1 39.2 50.4 49.6 35.6 57.4 20.8 65.2 4.8 70.4-12.4 69.6-29.6 68.8-48 62-58.7 49.1-69.4 36.2-72.4 17.2-70.4-.4-68.4-18-61.4-34.2-50-43.6-38.6-53-22.8-55.6-7.2-58.9 8.4-62.2 32.5-70.2 44.7-61.3Z"
            transform="translate(100 100)"></path>
        </svg>
        <svg class="blob blob-clay" viewBox="0 0 200 200" aria-hidden="true">
          <path
            fill="currentColor"
            d="M39.5-50.4C50.2-39.9 57.4-26.5 61.3-11.6 65.2 3.3 65.8 19.7 58.5 31.5 51.2 43.3 36 50.5 20.4 56.4 4.8 62.3-11.2 66.9-25.4 62.6-39.6 58.3-52 45.1-59.3 29.9-66.6 14.7-68.8-2.5-63.6-17.3-58.4-32.1-45.8-44.5-32.1-54.4-18.4-64.3-3.6-71.7 9.4-69.4 22.4-67.1 28.8-60.9 39.5-50.4Z"
            transform="translate(100 100)"></path>
        </svg>
        <div class="portrait-frame">
          <Picture
            src={retrato}
            alt="Carla Castellano Ayuso, psicóloga de ConCiencia"
            widths={[360, 540, 720, 1086]}
            sizes="(max-width: 860px) 80vw, 420px"
            formats={["avif", "webp"]}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="portrait-badge">
          <span class="badge-name">{CARLA.nombre}</span>
          <span class="badge-meta">{CARLA.cargo} · Col. {CARLA.colegiada}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="facts" aria-label="En pocas palabras">
    <ul class="wrap facts-list">
      <li>
        <Icon name="lucide:shield-check" aria-hidden="true" />
        <span><strong>Psicóloga General Sanitaria</strong> Colegiada {CARLA.colegiada}</span>
      </li>
      <li>
        <Icon name="lucide:map-pin" aria-hidden="true" />
        <span><strong>Presencial y online</strong> Benisanó, Sagunto y Valencia</span>
      </li>
      <li>
        <Icon name="lucide:leaf" aria-hidden="true" />
        <span><strong>Enfoque integrador</strong> Basado en la evidencia</span>
      </li>
    </ul>
  </section>

  <section id="mirada-profesional" class="section section-tint" aria-labelledby="mirada-title">
    <div class="wrap mirada">
      <div class="mirada-head">
        <p class="eyebrow">Mi mirada profesional</p>
        <h2 id="mirada-title">
          Comprender a cada persona <em class="serif-italic">en su conjunto</em>
        </h2>
        <p class="muted mirada-intro">
          La terapia es una oportunidad para comprender mejor lo que estás viviendo, identificar qué
          necesitas y desarrollar herramientas que te permitan afrontar las dificultades de otra
          manera.
        </p>
      </div>
      <div class="mirada-body muted">
        <p>
          Entiendo la psicología como un proceso de comprensión y cambio, en el que cada persona
          necesita encontrar su propio camino.
        </p>
        <p>
          Por eso, mi forma de trabajar parte de una mirada integradora, que combina diferentes
          enfoques y herramientas psicológicas para ofrecer un acompañamiento adaptado a las
          necesidades, circunstancias y momento vital de cada persona.
        </p>
        <p>
          Mis intervenciones se basan principalmente en la terapia cognitivo-conductual, las terapias
          de tercera generación y sistémica, incorporando también una perspectiva de trauma. Esto me
          permite tener en cuenta no solo lo que pensamos, sentimos y hacemos, sino también nuestra
          historia, las experiencias que hemos vivido y el contexto en el que nos desenvolvemos.
        </p>
        <p>
          Trabajo desde una base científica, apoyándome en estrategias y herramientas respaldadas por
          la evidencia. Sin embargo, creo que la psicología va más allá de aplicar técnicas o seguir
          un protocolo: implica comprender a cada persona en su conjunto, identificar qué necesita y
          encontrar la manera de acompañarla en su proceso.
        </p>
        <p>
          Mi objetivo es ayudarte a comprender lo que estás viviendo, reconocer tus propios recursos y
          desarrollar nuevas herramientas que te permitan afrontar las dificultades y generar cambios
          significativos en las diferentes áreas de tu vida.
        </p>
        <a class="link-arrow mirada-link" href="/formacion/">
          Conoce mi formación
          <Icon name="lucide:arrow-up-right" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="quote-band" aria-label="Cita">
    <figure class="wrap-narrow">
      <Icon name="lucide:quote" class="quote-mark" aria-hidden="true" />
      <blockquote>
        No tienes que tenerlo todo claro para empezar. Solo necesitas un lugar donde poder ser tú.
      </blockquote>
      <figcaption>{CARLA.nombre}</figcaption>
    </figure>
  </section>

  <section class="section" aria-labelledby="ambitos-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Ámbitos de intervención</p>
          <h2 id="ambitos-title">¿En qué puedo ayudarte?</h2>
        </div>
        <a class="link-arrow" href="/ambitos/">
          Ver todos los ámbitos
          <Icon name="lucide:arrow-up-right" aria-hidden="true" />
        </a>
      </div>
      <ul class="areas">
        {
          SERVICIOS.map((s) => (
            <li>
              <a class="area" href={conPagina.has(s.id) ? `/ambitos/${s.id}/` : `/ambitos/#${s.id}`}>
                <span class="area-icon">
                  <Icon name={s.icono} aria-hidden="true" />
                </span>
                <span>{s.titulo}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="faq-title">
    <div class="wrap faq-home">
      <div>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 id="faq-title">Antes de empezar</h2>
        <p class="muted faq-home-text">
          Lo que más se pregunta sobre las sesiones, los precios y cómo trabajo.
        </p>
        <a class="link-arrow" href="/preguntas-frecuentes/">
          Ver todas las preguntas
          <Icon name="lucide:arrow-up-right" aria-hidden="true" />
        </a>
      </div>
      <Faq preguntas={PREGUNTAS.slice(0, 5)} />
    </div>
  </section>

  <section class="section section-sage cta" aria-labelledby="cta-title">
    <div class="wrap-narrow">
      <p class="eyebrow">Un primer encuentro</p>
      <h2 id="cta-title">¿Hablamos?</h2>
      <p class="lead">
        Escríbeme por WhatsApp o, si prefieres no compartir tu número personal, por correo. Te
        respondo personalmente, sin compromiso.
      </p>
      <ContactButtons center />
    </div>
  </section>

  <ConsultationMap />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 7vw, 96px) clamp(56px, 8vw, 112px);
    background:
      radial-gradient(ellipse 60% 50% at 0% 0%, var(--clay-soft) 0%, transparent 70%),
      radial-gradient(ellipse 50% 60% at 100% 100%, var(--sage) 0%, transparent 70%), var(--paper);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(40px, 7vw, 96px);
    align-items: center;
  }

  .hero-title {
    margin-top: 18px;
    font-size: clamp(3.6rem, 9vw, 6.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--green-deep);
  }

  .hero-title em {
    color: var(--green);
  }

  .hero-quote {
    margin-top: 22px;
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 1.7rem);
    font-style: italic;
    line-height: 1.4;
    color: var(--ink);
  }

  .hero-text {
    margin-top: 22px;
    max-width: 58ch;
    color: var(--ink-soft);
  }

  .hero-actions {
    margin-top: 32px;
  }

  .portrait {
    position: relative;
    width: min(100%, 420px);
    margin: 0 auto;
  }

  .portrait-frame {
    position: relative;
    overflow: hidden;
    padding: 10px;
    border-radius: 999px 999px var(--radius-l) var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .portrait-frame :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 999px 999px calc(var(--radius-l) - 8px) calc(var(--radius-l) - 8px);
  }

  .blob {
    position: absolute;
    z-index: 0;
  }

  .blob-sage {
    width: 78%;
    right: -26%;
    top: 8%;
    color: var(--sage-2);
  }

  .blob-clay {
    width: 56%;
    left: -24%;
    bottom: 4%;
    color: var(--clay-soft);
  }

  .portrait-badge {
    position: absolute;
    left: -8%;
    bottom: 9%;
    display: grid;
    gap: 2px;
    padding: 14px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--surface) 92%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow);
  }

  .badge-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .badge-meta {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
  }

  /* ---------- Datos rápidos ---------- */
  .facts {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  .facts-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-block: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 26px 24px;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .facts li + li {
    border-left: 1px solid var(--line);
  }

  .facts strong {
    display: block;
    font-size: 1rem;
    color: var(--ink);
  }

  .facts svg {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: var(--clay);
  }

  /* ---------- Mirada ---------- */
  .mirada {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 7vw, 96px);
    align-items: start;
  }

  .mirada-head {
    position: sticky;
    top: 120px;
  }

  .mirada-head h2 {
    margin-top: 16px;
  }

  .mirada-head h2 em {
    color: var(--green);
  }

  .mirada-intro {
    margin-top: 20px;
    font-size: 1.1rem;
  }

  .mirada-body {
    font-size: 1.07rem;
  }

  .mirada-link {
    margin-top: 28px;
  }

  /* ---------- Cita ---------- */
  .quote-band {
    padding-block: clamp(64px, 9vw, 112px);
    background: var(--green-deep);
    color: #f3efe6;
    text-align: center;
  }

  .quote-band figure {
    margin-block: 0;
  }

  .quote-mark {
    width: 40px;
    height: 40px;
    margin: 0 auto 22px;
    color: #e8b896;
  }

  .quote-band blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-style: italic;
    line-height: 1.35;
    text-wrap: balance;
  }

  .quote-band figcaption {
    margin-top: 24px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #b3c2b0;
  }

  /* ---------- Ámbitos ---------- */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px 32px;
    margin-bottom: 40px;
  }

  .section-head h2 {
    margin-top: 14px;
  }

  .areas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .area {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 100%;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      border-color 0.3s;
  }

  .area:hover {
    color: var(--ink);
    border-color: var(--sage-2);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .area-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: 14px;
    background: var(--sage);
    color: var(--green);
  }

  .area-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  /* ---------- Preguntas ---------- */
  .faq-home {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .faq-home h2 {
    margin-top: 14px;
  }

  .faq-home-text {
    margin: 14px 0 22px;
  }

  @media (max-width: 860px) {
    .faq-home {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- CTA ---------- */
  .cta {
    text-align: center;
  }

  .cta h2 {
    margin-top: 14px;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
  }

  .cta .lead {
    max-width: 52ch;
    margin: 18px auto 32px;
  }

  @media (max-width: 960px) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 860px) {
    .hero-grid,
    .mirada {
      grid-template-columns: 1fr;
    }

    .portrait {
      width: min(78%, 360px);
      order: -1;
    }

    .portrait-badge {
      left: -14%;
    }

    .mirada-head {
      position: static;
    }

    .facts-list {
      grid-template-columns: 1fr;
    }

    .facts li + li {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .facts li {
      padding: 18px 0;
    }
  }

  @media (max-width: 560px) {
    .areas {
      grid-template-columns: 1fr;
    }

    .portrait-badge {
      left: 50%;
      bottom: -28px;
      transform: translateX(-50%);
      width: max-content;
      max-width: 100%;
      text-align: center;
    }

    .portrait {
      margin-bottom: 28px;
    }
  }
</style>

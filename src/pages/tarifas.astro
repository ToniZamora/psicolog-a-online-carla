---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import { TARIFAS } from "../data/site";
---

<Base
  title="Tarifas de psicología presencial y online · ConCiencia"
  description="Precios de las sesiones de psicología con Carla Castellano en Benisanó, Sagunto, Valencia y online. Sesiones de 50 minutos desde 60 €."
  migas={[{ nombre: "Tarifas", href: "/tarifas/" }]}
>
  <PageIntro label="Tarifas" title="Precios claros para cada modalidad">
    <p>Estas son las tarifas de las sesiones de psicología según la ubicación o modalidad.</p>
  </PageIntro>
  <section class="pb-20 md:pb-28">
    <div class="mx-auto grid max-w-5xl gap-6 px-6 md:grid-cols-2">
      {
        TARIFAS.map(({ ubicacion, precios }) => (
          <article class="rounded-3xl border border-border bg-card p-7 shadow-sm md:p-9">
            <h2 class="font-display text-2xl font-semibold text-primary">{ubicacion}</h2>
            <dl class="mt-6 divide-y divide-border border-y border-border">
              {precios.map(({ concepto, precio }) => (
                <div class="flex items-center justify-between gap-4 py-5">
                  <dt class="text-muted-foreground">{concepto}</dt>
                  <dd class="font-display text-2xl font-semibold">{precio}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
  </section>
</Base>

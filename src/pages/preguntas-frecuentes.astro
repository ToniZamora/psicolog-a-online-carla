---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import Faq from "../components/Faq.astro";
import ContactButtons from "../components/ContactButtons.astro";
import { PREGUNTAS } from "../data/site";
import { preguntasFrecuentes } from "../lib/schema";
---

<Base
  title="Preguntas frecuentes sobre la terapia · ConCiencia Psicología"
  description="Duración y precio de las sesiones, terapia online, atención a niños y adolescentes, enfoque terapéutico y cómo pedir cita con Carla Castellano, psicóloga sanitaria."
  schema={[preguntasFrecuentes(PREGUNTAS)]}
  migas={[{ nombre: "Preguntas frecuentes", href: "/preguntas-frecuentes/" }]}
>
  <PageIntro label="Preguntas frecuentes" title="Lo que suele preguntarse antes de empezar">
    <p>Si tu duda no está aquí, escríbeme y te respondo personalmente.</p>
  </PageIntro>
  <section class="py-12 md:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <Faq preguntas={PREGUNTAS} nivel="h2" />
    </div>
    <div class="mx-auto mt-14 max-w-3xl px-6">
      <div class="rounded-[var(--radius)] border border-border bg-secondary/60 px-7 py-10 text-center md:px-12">
        <p class="font-display text-2xl leading-snug text-foreground md:text-[1.75rem]">¿Te queda alguna duda?</p>
        <p class="mx-auto mt-4 max-w-xl leading-relaxed text-foreground">
          Escríbeme sin compromiso y te respondo personalmente.
        </p>
        <div class="mt-7">
          <ContactButtons />
        </div>
      </div>
    </div>
  </section>
</Base>

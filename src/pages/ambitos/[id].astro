---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import Base from "../../layouts/Base.astro";
import ContactButtons from "../../components/ContactButtons.astro";
import Faq from "../../components/Faq.astro";
import { CARLA, ONLINE, SERVICIOS, SITE, UBICACIONES } from "../../data/site";
import { ambitosVisibles } from "../../lib/ambitos";
import { ID_CARLA, ID_CONSULTA, preguntasFrecuentes } from "../../lib/schema";
import { btn } from "../../lib/ui";

export const getStaticPaths = (async () => {
  const entradas = await ambitosVisibles();
  return entradas.map((entrada) => ({ params: { id: entrada.id }, props: { entrada } }));
}) satisfies GetStaticPaths;

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const servicio = SERVICIOS.find((s) => s.id === entrada.id);
const url = `${SITE.url}/ambitos/${entrada.id}/`;
const otros = SERVICIOS.filter((s) => s.id !== entrada.id);
const conPagina = new Set((await ambitosVisibles()).map((e) => e.id));
const hrefAmbito = (id: string) => (conPagina.has(id) ? `/ambitos/${id}/` : `/ambitos/#${id}`);

const schema = [
  {
    "@type": "MedicalWebPage",
    "@id": url,
    url,
    name: entrada.data.titulo,
    description: entrada.data.descripcion,
    inLanguage: "es",
    author: { "@id": ID_CARLA },
    reviewedBy: { "@id": ID_CARLA },
    about: { "@type": "MedicalTherapy", name: servicio?.titulo ?? entrada.data.titulo },
    isPartOf: { "@id": ID_CONSULTA },
  },
  ...(entrada.data.preguntas.length ? [preguntasFrecuentes(entrada.data.preguntas)] : []),
];
---

<Base
  title={entrada.data.seoTitulo}
  description={entrada.data.descripcion}
  noindex={!entrada.data.publicado}
  schema={schema}
  migas={[
    { nombre: "Ámbitos de intervención", href: "/ambitos/" },
    { nombre: servicio?.titulo ?? entrada.data.titulo, href: `/ambitos/${entrada.id}/` },
  ]}
>
  {
    !entrada.data.publicado && (
      <p class="bg-accent px-6 py-3 text-center text-sm text-foreground" role="status">
        Borrador: solo visible en local. Para publicarlo, pon <code>publicado: true</code> en{" "}
        <code>src/content/ambitos/{entrada.id}.md</code>.
      </p>
    )
  }

  <section class="editorial-intro pb-14 pt-8 md:pb-20 md:pt-10">
    <div class="mx-auto max-w-6xl px-6">
      <a href="/ambitos/" class={btn({ variant: "link", class: "h-auto px-0 py-2" })}>
        <Icon name="lucide:arrow-left" aria-hidden="true" />
        Ámbitos de intervención
      </a>
      <div class="mx-auto mt-10 max-w-3xl text-center md:mt-12">
        {servicio && <Icon name={servicio.icono} class="mx-auto size-8 text-primary" stroke-width="1.4" aria-hidden="true" />}
        <h1 class="mt-5 font-display text-4xl font-normal leading-tight md:text-5xl">{entrada.data.titulo}</h1>
        {servicio && <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">{servicio.texto}</p>}
      </div>
    </div>
  </section>

  <section class="py-12 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 md:grid-cols-[1.4fr_0.8fr] md:gap-16">
      <article class="prose-c max-w-3xl">
        <Content />
        {
          entrada.data.preguntas.length > 0 && (
            <section class="mt-14 not-prose" aria-labelledby="ambito-faq-title">
              <p id="ambito-faq-title" class="text-xs font-semibold uppercase text-primary">Preguntas frecuentes</p>
              <div class="mt-6">
                <Faq preguntas={entrada.data.preguntas} />
              </div>
            </section>
          )
        }
      </article>

      <aside class="h-fit rounded-3xl border border-border bg-card p-7 text-center shadow-sm md:sticky md:top-28 md:p-9">
        <p class="text-xs font-semibold uppercase text-primary">Un primer encuentro</p>
        <h2 class="mt-4 font-display text-3xl">¿Hablamos?</h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Escríbeme sin compromiso. Atiendo en{" "}
          {UBICACIONES.map((u, i) => (
            <>
              <a href={`/${u.slug}/`} class="text-primary underline underline-offset-4">{u.nombre}</a>{i < UBICACIONES.length - 2 ? ", " : i === UBICACIONES.length - 2 ? " y " : ""}
            </>
          ))}, y también <a href={`/${ONLINE.slug}/`} class="text-primary underline underline-offset-4">online</a>.
        </p>
        <div class="mt-7">
          <ContactButtons class="flex-col" />
        </div>
        <p class="mt-7 border-t border-border pt-5 text-xs font-semibold uppercase text-muted-foreground">
          {CARLA.nombre} · Col. {CARLA.colegiada}
        </p>
      </aside>
    </div>
  </section>

  <section class="border-t border-border bg-secondary/50 py-16 md:py-20" aria-labelledby="otros-ambitos">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold uppercase text-primary">Ámbitos de intervención</p>
      <h2 id="otros-ambitos" class="mt-4 font-display text-3xl leading-tight md:text-4xl">Otros ámbitos en los que trabajo</h2>
      <div class="mt-8 grid gap-x-14 sm:grid-cols-2">
        {
          otros.map((s) => (
            <a href={hrefAmbito(s.id)} class="flex items-center gap-3 border-b border-border py-4 leading-snug hover:text-primary">
              <Icon name={s.icono} class="size-5 shrink-0 text-primary" stroke-width="1.4" aria-hidden="true" />
              {s.titulo}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
